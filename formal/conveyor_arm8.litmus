AArch64 ConveyorRing_SingleSlot_2Laps
"ARMv8-A Message-Passing + Ownership Hand-Back litmus test for ConveyorRing (2 laps on 1 slot)"
{
  0:X1=data; 0:X2=seq;
  1:X1=data; 1:X2=seq;
  data=0; seq=0;
}
 P0 (Producer)              | P1 (Consumer)              ;
 MOV W0,#1                  | LDAR W0,[X2]               ;
 STR W0,[X1]                | CMP W0,#1                  ;
 MOV W3,#1                  | B.NE L_end                 ;
 STLR W3,[X2]               | LDR W4,[X1]                ;
 LDAR W5,[X2]               | MOV W5,#2                  ;
 CMP W5,#2                  | STLR W5,[X2]               ;
 B.NE L_end0                | L_end:                     ;
 MOV W6,#2                  |                            ;
 STR W6,[X1]                |                            ;
 L_end0:                    |                            ;
exists
(1:X0=1 /\ (1:X4=0 \/ 1:X4=2))
